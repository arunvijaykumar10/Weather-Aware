# ==============================================================================
# Spotter Weather-Aware Truck Routing - Environment Configuration Template
# Copy this file to .env or backend/.env and fill in appropriate values.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Backend Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-development-placeholder-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Local CORS Configuration (Origin of the React + Vite frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API Base URL Configuration (Used by Vite)
VITE_API_URL=http://localhost:8000

# Upstream Provider Keys & API Configuration (Backend Only - Never expose to frontend)
# OpenRouteService API Key for multi-route generation
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
# Open-Meteo Hourly Forecast API Endpoint
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Rate Limiting & Throttling
ROUTE_ANALYSIS_THROTTLE_RATE=30/minute
